{
  "name": "@dactic/mcp-server",
  "version": "0.1.0",
  "description": "Connect AI clients to your Dactic work context through a hosted MCP service.",
  "type": "module",
  "license": "MIT",
  "mcpName": "io.dactic/dactic-mcp",
  "engines": {
    "node": ">=22.12.0"
  },
  "bin": {
    "dactic-mcp": "src/cli.js"
  },
  "files": [
    "src/",
    "README.md",
    "LICENSE",
    "NOTICE"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/Dactic-Monday/dactic-v1-mcp-public.git"
  },
  "homepage": "https://github.com/Dactic-Monday/dactic-v1-mcp-public",
  "bugs": {
    "url": "https://github.com/Dactic-Monday/dactic-v1-mcp-public/issues"
  },
  "keywords": [
    "mcp",
    "dactic",
    "stdio",
    "oauth"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "start": "node src/cli.js",
    "check": "node --check src/cli.js && node --check src/bridge.js && node scripts/validate.mjs",
    "test": "node --test --test-timeout=30000 test/*.test.js",
    "verify": "npm run check && npm test",
    "prepublishOnly": "npm run verify"
  },
  "dependencies": {
    "mcp-remote": "0.16.0"
  },
  "devDependencies": {
    "ajv": "8.20.0",
    "ajv-formats": "3.0.1",
    "yaml": "2.9.1"
  }
}
